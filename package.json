{
  "name": "streamhub-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Streamhub QA Automation Assessment (Section B): mock-data API, Playwright + Cucumber framework, EMI Calculator UI tests, SQL scenarios and an AI self-healing locator POC.",
  "scripts": {
    "api:start": "ts-node api/src/server.ts",
    "test": "npm run test:api && npm run test:sql && npm run test:ui",
    "test:api": "cucumber-js --profile api",
    "test:ui": "cucumber-js --profile ui",
    "test:sql": "cucumber-js --profile sql",
    "test:broken": "cucumber-js --profile broken",
    "test:healing": "cross-env SELF_HEAL=true cucumber-js --profile broken",
    "sql": "ts-node sql/run-sql.ts",
    "evidence": "ts-node scripts/run-all.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@cucumber/cucumber": "^12.9.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/sql.js": "^1.4.11",
    "ajv": "^8.20.0",
    "cross-env": "^10.1.0",
    "playwright": "^1.64.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "sql.js": "^1.15.2"
  }
}
