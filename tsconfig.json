{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": ["api/**/*.ts", "tests/**/*.ts", "sql/**/*.ts", "cucumber.js"]
}
