# Example of a second environment: the API is already deployed, so it is not started in-process.
# Run with: TEST_ENV=staging npm run test:api
API_BASE_URL=https://staging-catalogue.example.com
API_PORT=3000
START_API=false

EMI_BASE_URL=https://emicalculator.net/

BROWSER=chromium
HEADLESS=true
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=900
DEFAULT_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=60000
BLOCK_ADS=true

SELF_HEAL=false
HEAL_MODEL=claude-opus-5-5
