# QA environment (default). Selected with TEST_ENV=qa.
# Non-secret values only — secrets go in config/env/.env.local (git-ignored).

# --- Streamhub Catalogue API (B1/B2) ---
API_BASE_URL=http://localhost:3000
API_PORT=3000
# Start the API in-process before the API suite runs. Set false when pointing at a deployed API.
START_API=true

# --- EMI Calculator (B3) ---
EMI_BASE_URL=https://emicalculator.net/

# --- Browser ---
BROWSER=chromium
HEADLESS=true
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=900
DEFAULT_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=60000
# Abort ad/analytics requests so overlays and iframes cannot intercept clicks.
BLOCK_ADS=true

# --- AI self-healing POC ---
SELF_HEAL=false
HEAL_MODEL=claude-opus-5-5
